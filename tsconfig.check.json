{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "noEmit": true,
    "types": ["@cocos/creator-types/engine"]
  },
  "include": ["assets/scripts/**/*.ts", "types/**/*.d.ts"]
}
