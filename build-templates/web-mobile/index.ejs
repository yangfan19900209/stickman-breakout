<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <title>线条突围 · Stickman Breakout</title>
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="线条突围">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="theme-color" content="#faf9f5">
  <link rel="manifest" href="./manifest.webmanifest">
  <link rel="apple-touch-icon" href="./icons/apple-touch-icon.png">
  <link rel="icon" type="image/png" href="./icons/icon-192.png">
  <link rel="stylesheet" href="<%= cssUrl %>">
  <style>html,body{background:#faf9f5;margin:0;padding:0;border:0;width:100%;width:100dvw;height:100%;height:100dvh;overflow:hidden;overscroll-behavior:none;touch-action:none;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none}body,#GameDiv{position:fixed}#GameDiv{inset:0;margin:0;padding:0;overflow:hidden;touch-action:none}#GameDiv:fullscreen,#GameDiv:-webkit-full-screen{width:100%!important;height:100%!important;left:0!important;top:0!important}canvas{outline:none;touch-action:none}#safe-area-probe{position:fixed;visibility:hidden;pointer-events:none;padding:env(safe-area-inset-top,0px) env(safe-area-inset-right,0px) env(safe-area-inset-bottom,0px) env(safe-area-inset-left,0px)}</style>
</head>
<body>
  <div id="GameDiv" cc_exact_fit_screen="true">
    <div id="Cocos3dGameContainer">
      <canvas id="GameCanvas" oncontextmenu="event.preventDefault()" tabindex="0"></canvas>
    </div>
  </div>
  <div id="safe-area-probe"></div>
  <script src="./browser-platform.js"></script>
  <%- include(cocosTemplate, {}) %>
  <!-- Browser shell only: gameplay, input and UI all run through Cocos. -->
</body>
</html>
